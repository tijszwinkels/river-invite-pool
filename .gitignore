# web-container signing keys — determine each page's contract id; keep locally, never commit
.web-keys*.toml
# riverctl member key stores (plaintext member signing keys) — never commit
.riverctl-*/
# build artifacts (per-target staging dirs, tars, metadata, put logs)
.build/
# node deps (restorable via npm install)
node_modules/
read-spike/node_modules/
# generated sources (regenerated by scripts/build-web.sh <target>)
src/pool.generated.js
src/config.generated.js
# riverctl member key store for the real Off Topic room — never commit
.riverctl-offtopic/
# live invite pools — real single-use invites, regenerated by mint/refill; operational state, not source
pool/*-codes.txt
# mattermost bridge attachment inbox — not project source
.mattermost-inbox/
