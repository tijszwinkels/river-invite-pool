[Unit]
Description=River invite-pool auto-replenish (%i): top up to 50 when unused < 20
Documentation=https://github.com/tijszwinkels/river-invite-pool

[Service]
Type=oneshot
# %i = target name from targets.json (e.g. offtopic). Script defaults: low=20, target=50.
# To change thresholds, append args:  ExecStart=… %i <low> <target>
# ⚠ Adjust the path below to where YOU cloned this repo (%h = your home dir).
ExecStart=%h/projects/dataverse/freenet/river-invite-pool/scripts/autoreplenish.sh %i
TimeoutStartSec=600
